upstream pyforum {
{% if lb_method %}
    {{ lb_method }};
{% endif %}
{% for host in groups['app_servers'] %}
    server {{ hostvars[host].ansible_host }}:{{ lb_backend_port }} max_fails={{ lb_max_fails }} fail_timeout={{ lb_fail_timeout }};
{% endfor %}
}

server {
    listen 80;
    server_name {{ ansible_host }};

    client_max_body_size {{ lb_client_max_body_size }};

    location /media/ {
        alias {{ lb_media_dir }}/;
    }

    location / {
        proxy_pass http://pyforum;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout {{ lb_connect_timeout }};
        proxy_next_upstream error timeout http_502 http_503 http_504;
        add_header X-Upstream $upstream_addr always;
    }
}
